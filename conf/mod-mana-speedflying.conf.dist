#
# mod-mana-speedflying configuration
#
# Server-side companion to the client's wxl-mount-anim module. That module detects the flight state
# (climbing / leveling / diving) and already knows whether the mount carries the retail AdvFly
# clips, so it whispers an addon message (prefix "WXLMS") to this module, which blends the mount's
# flight speed to match. Nothing is guessed on the server, and only mounts the client drives with
# AdvFly are affected.
#

[worldserver]

########################################
# Mount speed by flight state
########################################

#
#    ManaSpeedFlying.Enable
#        Description: Enable the module. The client link still requires ServerLink=1 in
#                     wxl-mount-anim.ini on the client.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ManaSpeedFlying.Enable = 1

#
#    ManaSpeedFlying.ClimbSpeed
#        Description: Flight speed while climbing, as a multiplier of base run speed.
#                     2.0 = 200%. This is the slowest of the three.
#        Default:     2.0
#

ManaSpeedFlying.ClimbSpeed = 2.0

#
#    ManaSpeedFlying.LevelSpeed
#        Description: Flight speed while level (or hovering). 2.8 = 280%.
#        Default:     2.8
#

ManaSpeedFlying.LevelSpeed = 2.8

#
#    ManaSpeedFlying.DiveSpeed
#        Description: Flight speed while diving. 8.0 = 800%. This is the fastest. Changing this (and
#                     LevelSpeed) is enough: the module tells the client module these speeds, so the
#                     client's HUD, particles and shake scale to them with no client-side edit.
#        Default:     8.0
#

ManaSpeedFlying.DiveSpeed = 8.0

#
#    ManaSpeedFlying.BlendMs
#        Description: Default blend time, in milliseconds, for state changes other than a dive or
#                     a pull-out. It is spread over the climb <-> dive span, so a smaller hop
#                     (for example level -> climb) takes proportionally less. Raise it for a longer,
#                     lazier blend; lower it to let the speed react faster.
#        Default:     5500
#

ManaSpeedFlying.BlendMs = 5500

#
#    ManaSpeedFlying.DiveMs
#        Description: Time, in milliseconds, for the speed to build from wherever it is up to
#                     DiveSpeed when a dive begins. The curve starts with a small kick so the dive
#                     responds at once, then keeps accelerating -- faster and faster -- instead of
#                     snapping to speed. Lower it for an even punchier dive.
#        Default:     4000
#

ManaSpeedFlying.DiveMs = 4000

#
#    ManaSpeedFlying.GlideMs
#        Description: Time, in milliseconds, for a full dive to bleed back to LevelSpeed. Scaled by
#                     how much speed is actually being shed against the DiveSpeed - LevelSpeed
#                     drop, so pulling out of a shallow dive recovers sooner than a full one. The
#                     curve eases in, so the mount holds most of its speed at first and then slows
#                     hard before settling back to level.
#        Default:     18000
#

ManaSpeedFlying.GlideMs = 18000

#
#    ManaSpeedFlying.ClimbDecelMs
#        Description: Time, in milliseconds, to brake from a full dive straight into a climb.
#                     Scaled by the speed actually being shed, like GlideMs. The curve eases in, so
#                     the mount holds the dive speed for a moment -- letting the built-up speed be
#                     felt -- before braking hard into ClimbSpeed.
#        Default:     3500
#

ManaSpeedFlying.ClimbDecelMs = 3500

#
#    ManaSpeedFlying.HoverMs
#        Description: Time, in milliseconds, for the speed to move from a hover (a parked mount)
#                     into whatever state it heads to next -- climb, level or dive. Fixed, not
#                     scaled, so a take-off is always this brief accel/decel zone. Lower it for a
#                     snappier launch.
#        Default:     500
#

ManaSpeedFlying.HoverMs = 500

#
#    ManaSpeedFlying.SendMs
#        Description: Shortest interval, in milliseconds, between two flight-speed updates sent to
#                     the client while blending. Smaller is smoother but chattier.
#        Default:     150
#

ManaSpeedFlying.SendMs = 150

#
#    ManaSpeedFlying.TimeoutMs
#        Description: How long the client link may stay quiet before the mount's own speed is
#                     restored. The client heartbeats about once a second, so this only trips when
#                     the client module is unloaded, disabled or crashed. 0 disables the timeout.
#        Default:     2500
#

ManaSpeedFlying.TimeoutMs = 2500

#
#    ManaSpeedFlying.BoostAdd
#        Description: Speed the button boost adds to the glide, as a multiplier of base run speed.
#                     4.0 = 400%. It is added to the mount's current speed, so a boost can carry a
#                     glide past the dive ceiling, and the added speed is then spent as ordinary
#                     glide time instead of a fixed burst. The total is capped by BoostSpeed.
#        Default:     4.0
#

ManaSpeedFlying.BoostAdd = 4.0

#
#    ManaSpeedFlying.BoostSpeed
#        Description: Hard ceiling a boost may lift the mount to, as a multiplier of base run speed.
#                     16.0 = 1600%. It must be at least DiveSpeed. A boost adds BoostAdd to the
#                     current speed, up to this value.
#        Default:     16.0
#

ManaSpeedFlying.BoostSpeed = 16.0

#
#    ManaSpeedFlying.BoostMs
#        Description: How long, in milliseconds, the client hides the stack gain after a boost, so
#                     the boost's own extra speed cannot refill the stack it just spent. The extra
#                     speed itself is not timed: it bleeds off through the ordinary glide.
#        Default:     4000
#

ManaSpeedFlying.BoostMs = 4000

#
#    ManaSpeedFlying.BoostCooldownMs
#        Description: Cooldown, in milliseconds, before the next boost may fire. Shown as a swipe on
#                     the client's boost button.
#        Default:     3000
#

ManaSpeedFlying.BoostCooldownMs = 3000

#
#    ManaSpeedFlying.BoostMaxStacks
#        Description: Most boost stacks the button may hold (0..3). A dive builds them by speed, not
#                     flight state, so a dive that peaks as the mount pulls out still counts: 50% of
#                     the way from LevelSpeed to DiveSpeed grants one, 80% two and the full dive
#                     ceiling three. Each boost spends one stack and locks gains until the speed has
#                     fallen back below the first tier.
#        Default:     3
#

ManaSpeedFlying.BoostMaxStacks = 3
